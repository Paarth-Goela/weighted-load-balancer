# Copy to .env and set a real secret:  openssl rand -hex 32
TRAFFIC_API_TOKEN=change-me-to-a-random-32-byte-hex-string

# Optional: read-only token for GET /metrics, used by the Prometheus service
# (docker compose --profile observability up -d). Must differ from the admin
# token:  openssl rand -hex 32
# METRICS_TOKEN=

# Load-test attribution headers on HAProxy responses (local simulation only):
# EXPOSE_ROUTING_HEADERS=1

# Optional overrides (defaults shown)
# BOOTSTRAP_FILE=/app/bootstrap/bootstrap.simulation.json
# HEALTH_CHECK_INTERVAL_SECONDS=2
# HEALTH_FAILURE_THRESHOLD=3
# HEALTH_RECOVERY_THRESHOLD=2
# HEALTH_RECOVERY_HOLD_SECONDS=0
# DRAIN_TIMEOUT_SECONDS=10
# HAPROXY_CA_FILE=@system-ca
# OPDK_NATIVE_CHECK_PATH=/healthz
# HYBRID_NATIVE_CHECK_PATH=/healthz
